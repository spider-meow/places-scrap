# Copie ce fichier en .env et renseigne tes clés (ne commit jamais .env)

# Clé API Google Cloud avec Places API (New) activée
GOOGLE_PLACES_API_KEY=ton_cle_places_ici

# Clé API Google Cloud avec Custom Search API activée
# (peut être la même clé Cloud si les deux APIs sont activées sur le projet)
GOOGLE_CSE_API_KEY=ton_cle_custom_search_ici

# ID du moteur Programmable Search Engine (cx)
# Créer sur https://programmablesearchengine.google.com/
# → cocher "Rechercher sur tout le web"
GOOGLE_CSE_CX=ton_cx_ici
